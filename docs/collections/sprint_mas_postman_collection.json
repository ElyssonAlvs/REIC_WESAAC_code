      "name": "1. Cenários de Planejamento (A, B, C)",
      "description": "Execução dos cenários de teste empíricos sob arquitetura BDI em LangGraph com respeito a restrições de DAG e capacidade FTE.",
      "item": [
        {
          "name": "Cenário A - Backlog Padrão (10 Tarefas, 35 pts)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenario\": \"scenario_a\",\n  \"sprint_goal\": \"Deliver highest business value tasks respecting DAG dependencies and team FTE capacity.\",\n  \"sprint_days\": 10,\n  \"points_per_day\": 2.0,\n  \"max_retries\": 2,\n  \"thread_id\": \"{{thread_id}}_scenario_a\",\n  \"offline_mock\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sprint-planning",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sprint-planning"]
            },
            "description": "Executa o Cenário A (10 tarefas lineares, 35 story points, 3 devs FTE=1.0). Valida se 100% das tarefas são alocadas e o plano é aprovado com 0 violações."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Sprint Plan is approved with 0 governance violations\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"APPROVED\");",
                  "    pm.expect(jsonData.validation_errors).to.be.an(\"array\").that.is.empty;",
                  "    pm.expect(jsonData.sprint_plan.total_points).to.eql(35);",
                  "    pm.expect(jsonData.sprint_plan.tasks.length).to.eql(10);",
                  "});"
                ]
              }
            }
          ]
        },
        {

          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Section 6.3 dev_D 0.5 FTE ceiling respected (<= 10.0 pts)\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"APPROVED\");",
                  "    var devDLoad = jsonData.developer_loads.dev_D;",
                  "    pm.expect(devDLoad.allocated_points).to.be.at.most(10.0);",
                  "    pm.expect(devDLoad.capacity_ceiling).to.eql(10.0);",
                  "});",
                  "pm.test(\"Replan triggered and trace contains corrective replan pass\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.trace.replan_triggered).to.be.true;",
                  "    pm.expect(jsonData.trace.validation_attempts).to.be.at.least(2);",
                  "});"
                ]
              }
            }
